# Highway Grill HRMS — copy to .env and adjust for your machine

# --- Frontend (Vite) ---
VITE_API_BASE=/api
VITE_DEV_PORT=5173

# Vite dev proxy — pick ONE backend:
# XAMPP PHP:  VITE_PROXY_TARGET=http://localhost  VITE_PROXY_API_PATH=/HG_web/api/index.php
# Node API:   VITE_PROXY_TARGET=http://localhost:3001  VITE_PROXY_API_PATH=/api
VITE_PROXY_TARGET=http://localhost
VITE_PROXY_API_PATH=/HG_web/api/index.php

# Mapbox maps (optional — without token, OSM/Esri fallbacks are used)
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v11

# --- Node API (server/) ---
# Copy DATABASE_URL to server/.env.local — Next.js reads env from server/, not root .env
DATABASE_URL=postgresql://user:password@host.neon.tech/hg-web?sslmode=require
# Optional — employee photo uploads on Vercel (from Vercel Blob storage)
BLOB_READ_WRITE_TOKEN=

# --- PHP API (XAMPP — local legacy) ---
APP_ENV=local

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=highway_grill_hrms
DB_USER=root
DB_PASS=

CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=24

# true = bcrypt via password_verify; false = plain text in password_hash column
AUTH_HASH_PASSWORDS=false

# Email / SMTP (required for payslip PDF delivery)
MAIL_ENABLED=false
MAIL_FROM=noreply@highwaygrill.local
MAIL_FROM_NAME=Highway Grill HR
HR_NOTIFY_EMAIL=hr@highwaygrill.local
APP_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
