# Highway Grill HRMS — copy to .env and adjust for your machine

# --- Frontend (Vite) ---
VITE_API_BASE=/api
VITE_DEV_PORT=5173

# Vite dev proxy — pick ONE backend:
# XAMPP PHP:  VITE_PROXY_TARGET=http://localhost  VITE_PROXY_API_PATH=/HG_web/api/index.php
# Node API:   VITE_PROXY_TARGET=http://localhost:3001  VITE_PROXY_API_PATH=/api
VITE_PROXY_TARGET=http://localhost
VITE_PROXY_API_PATH=/HG_web/api/index.php

# Mapbox maps (optional — without token, OSM/Esri fallbacks are used)
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v11

# --- Node API + Vercel (copy to Vercel env vars; keep server/.env.local in sync) ---
DATABASE_URL=postgresql://user:password@host.neon.tech/hg-web?sslmode=require
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=24
AUTH_HASH_PASSWORDS=true

# Email / SMTP — payslip PDF delivery
MAIL_ENABLED=false
MAIL_FROM=noreply@highwaygrill.local
MAIL_FROM_NAME=Highway Grill HR
HR_NOTIFY_EMAIL=hr@highwaygrill.local
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls

# Vercel Blob — profile photos, documents, payslip archive (link Blob store in Vercel Storage)
BLOB_READ_WRITE_TOKEN=
