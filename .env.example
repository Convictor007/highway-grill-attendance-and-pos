# Highway Grill HRMS — copy to .env and adjust for your machine

# --- Frontend (Vite) ---
VITE_API_BASE=/api
VITE_DEV_PORT=5173

# Vite dev proxy → XAMPP Apache
VITE_PROXY_TARGET=http://localhost
VITE_PROXY_API_PATH=/HG_web/api/index.php

# Mapbox maps (optional — without token, OSM/Esri fallbacks are used)
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v11

# --- PHP API ---
APP_ENV=local

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=highway_grill_hrms
DB_USER=root
DB_PASS=

CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=24

# true = bcrypt via password_verify; false = plain text in password_hash column
AUTH_HASH_PASSWORDS=false

# Email / SMTP (required for payslip PDF delivery)
MAIL_ENABLED=false
MAIL_FROM=noreply@highwaygrill.local
MAIL_FROM_NAME=Highway Grill HR
HR_NOTIFY_EMAIL=hr@highwaygrill.local
APP_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
