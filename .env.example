# Highway Grill HRMS — copy this to .env and fill in your values

# --- Vite frontend ---
VITE_API_BASE=/api
VITE_DEV_PORT=5173
VITE_PROXY_TARGET=http://localhost:3001
VITE_PROXY_API_PATH=/api

# Mapbox (optional, OSM fallback if empty)
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v11

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- API Server ---
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=24
AUTH_HASH_PASSWORDS=true

# --- Email / SMTP (payslip delivery) ---
MAIL_ENABLED=false
MAIL_FROM=
MAIL_FROM_NAME=Highway Grill HR
HR_NOTIFY_EMAIL=
APP_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls

# --- Vercel Blob (profile photos, HR documents) ---
BLOB_READ_WRITE_TOKEN=

# --- Cron ---
CRON_SECRET=
