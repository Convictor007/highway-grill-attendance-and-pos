  {
  "framework": "nextjs",
  "regions": ["sin1"],
  "installCommand": "cd .. && npm run install:vercel",
  "buildCommand": "cd .. && npm run build:vercel",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/close-stale-sessions",
      "schedule": "0 20 * * *"
    }
  ]
}
